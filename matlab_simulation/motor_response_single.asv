load_parameters();

Kp = 8;
out = sim("motor_model.slx");
subplot(2, 1, 1)
plot(out.tout, out.motor_position.Data, 'DisplayName', "Motor position")
xlabel("Time (s)")
ylabel("Position (rad)")
grid on
subplot(2, 1, 2)
plot(out.tout, out.motor_current.Data, 'DisplayName', "Motor current")
xlabel("Time (s)")
ylabel("Current (A)")
grid on
xlim([0 5])
title("DC motor response to position feedback control")
